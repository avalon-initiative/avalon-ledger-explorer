{
  "name": "avalon-ledger-explorer",
  "private": true,
  "version": "0.1.0",
  "description": "Independent public ledger explorer and verifier for Avalon: checks a node's tree heads, witness cosignatures and proofs in the browser through the protocol SDK, trusting no server. A read-only client.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run"
  },
  "dependencies": {
    "@avalon-initiative/common-ui": "0.1.2",
    "@avalon-initiative/protocol-sdk": "0.1.4",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.1",
    "@vitejs/plugin-vue": "^6.0.9",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.0.1",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.0",
    "sass": "^1.104.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1",
    "vue-tsc": "^3.3.11"
  }
}
